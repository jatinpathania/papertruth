# ---- PaperTruth client configuration ----
#
# LOCAL: leave BLANK. The Vite dev server proxies /api to http://localhost:5000
# (see vite.config.js), so the browser talks to one origin and there is no CORS.
#
# VERCEL: leave BLANK too. The API is served from /api on the same domain, so
# relative requests already reach it. Only set this if the API is hosted on a
# DIFFERENT domain, e.g. VITE_API_URL=https://papertruth-api.onrender.com
VITE_API_URL=
