# ---- PaperTruth server configuration ----

# LOCAL: a local mongod.
# VERCEL: a MongoDB Atlas connection string. Include the database name, and
# allow 0.0.0.0/0 under Atlas > Network Access (serverless has no fixed IP).
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/papertruth?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/papertruth

# Must be at least 24 characters in production or the server refuses to start.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a sign-in lasts before the student has to sign in again.
# Any jsonwebtoken duration: 30m, 12h, 2d, 7d. Defaults to 2d.
JWT_EXPIRES_IN=2d

# LOCAL only. On Vercel the platform supplies the port — do not set it.
PORT=5000

# Origin(s) allowed by CORS, comma-separated.
# LOCAL : http://localhost:5173
# VERCEL: not needed when the client and API share one domain. Set it only if
#         they are on different domains, e.g. https://papertruth.vercel.app
CLIENT_URL=http://localhost:5173

# Optional. Used ONLY to semantically group free-text short answers.
# Leave blank: the app runs fully without it (edit-distance grouping is used instead).
GEMINI_API_KEY=

# ---- Email verification (registration OTP) ----
# Leave blank in development: the code is printed to the server console instead.
# In PRODUCTION these are required, or registration will fail rather than silently
# skip verification.
# Gmail: host=smtp.gmail.com port=587 user=<your gmail> pass=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
